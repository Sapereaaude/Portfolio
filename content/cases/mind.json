  "decisions": true,
  "sections": [
    {
      "title": "The context",
      "long_title": false,
      "wrap": "pretty",
      "blocks": [
        {
          "type": "text",
          "style": "plain",
          "text": "Therapy was still stigmatised, even taboo, in France. We wanted to map how French people think about therapy, and whether an app could lower the friction."
        }
      ]
    },
    {
      "title": "The question",
      "long_title": false,
      "wrap": "pretty",
      "blocks": [
        {
          "type": "list",
          "items": [
            "Understand the French population’s mental models of therapy",
            "Find what stops people from seeking help",
            "Find where Alan Mind can fit into that journey"
          ]
        }
      ]
    },
    {
      "title": "What I did",
      "long_title": false,
      "wrap": "pretty",
      "blocks": [
        {
          "type": "list",
          "items": [
            "Interviews on beliefs about, and experiences of, therapy",
            "Mental-model mapping",
            "Concept and wording tests"
          ]
        }
      ]
    },
    {
      "title": "What we learned",
      "long_title": false,
      "wrap": "pretty",
      "blocks": [
        {
          "type": "list",
          "items": [
            "People needed therapy, and wanted it.",
            "They wanted it on desktop, not on mobile.",
            "Some were wary of therapy paid for by their employer: would it come with strings attached?",
            "The main friction was finding a good therapist."
          ]
        }
      ]
    },
    {
      "title": "What changed",
      "long_title": false,
      "wrap": "pretty",
      "blocks": [
        {
          "type": "list",
          "items": [
            "We quickly moved to desktop and dropped mobile.",
            "We added an orientation session, to help people find the right therapist."
          ]
        }
      ]
    },
    {
      "title": "What I liked",
      "long_title": false,
      "wrap": "pretty",
      "blocks": [
        {
          "type": "text",
          "style": "quote",
          "text": "Having an impact on people’s lives."
        }
      ]
    },
    {
      "title": "What I’d change",
      "long_title": false,
      "wrap": "pretty",
      "blocks": [
        {
          "type": "text",
          "style": "plain",
          "text": "More time, and more psychological training, to absorb what came up in the interviews."
        }
      ]
    }
  ],
