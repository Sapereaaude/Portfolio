  "sections": [
    {
      "title": "The context",
      "long_title": false,
      "wrap": "pretty",
      "blocks": [
        {
          "type": "text",
          "style": "plain",
          "text": "Five teams building internal tools for product creation had insights everywhere and nowhere: slides, Notion pages, people’s heads."
        }
      ]
    },
    {
      "title": "The question",
      "long_title": false,
      "wrap": "pretty",
      "blocks": [
        {
          "type": "list",
          "items": [
            "Understand how teams collect and use user knowledge",
            "Give them one place where insights live and stay alive",
            "Make discovery continuous, not a one-off"
          ]
        }
      ]
    },
    {
      "title": "What I did",
      "long_title": false,
      "wrap": "pretty",
      "blocks": [
        {
          "type": "list",
          "items": [
            "3-week study: interviews and a survey with stakeholders",
            "“We understood that… so we recommend that…” report, then one workshop per team",
            "One atomic research repository in Airtable, tags built with designers",
            "Monthly Research Grooming before sprint planning, weekly office hours"
          ]
        },
        {
          "type": "custom",
          "html": "<figure style=\"margin: 20px 0 0; padding: 20px; border-radius: 16px; background: #F7F8FC; border: 1px solid #E3E3EA\">\n<div style=\"display: flex; flex-direction: column; gap: 6px\"><div style=\"width: 40%; margin: 0 auto; padding: 10px; text-align: center; border-radius: 8px; background: {{accent}}; color: #FFFFFF; box-sizing: border-box\"><span style=\"font-size: 14px; font-weight: 700\">Recommendations</span><span style=\"font-size: 12px\"> · “So we recommend that…”</span></div><div style=\"width: 60%; margin: 0 auto; padding: 10px; text-align: center; border-radius: 8px; background: #7D93D4; color: #FFFFFF; box-sizing: border-box\"><span style=\"font-size: 14px; font-weight: 700\">Insights</span><span style=\"font-size: 12px\"> · Patterns across observations</span></div><div style=\"width: 80%; margin: 0 auto; padding: 10px; text-align: center; border-radius: 8px; background: #D5D9EE; color: #17171F; box-sizing: border-box\"><span style=\"font-size: 14px; font-weight: 700\">Observations</span><span style=\"font-size: 12px\"> · One fact, one user, tagged</span></div></div>\n<figcaption style=\"margin-top: 14px; font-size: 12px; font-weight: 600; color: #4A4A57\">Atomic research, from facts to decisions</figcaption>\n</figure>"
